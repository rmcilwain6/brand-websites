NEXT_PUBLIC_SITE_NAME=Evryday Archive

# URL of the deployed admin app — used to fetch published galleries/packages
ADMIN_API_BASE_URL=http://localhost:3001

# Direct DB connection — required for waitlist and any public-app DB writes
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evrydayarchive

# Set to "true" to redirect all public routes to /coming-soon
NEXT_PUBLIC_COMING_SOON=false

# Resend — transactional email
RESEND_API_KEY=
NOTIFICATION_EMAIL=reed@evrydayarchive.co
