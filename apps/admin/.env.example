NEXT_PUBLIC_SITE_NAME=Evryday Admin

# Public base URL of this admin app (used for internal API references)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evrydayarchive

# Single-password admin authentication
ADMIN_PASSWORD=
AUTH_SECRET=

# Cloudinary — used for image uploads in the gallery editor
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email
RESEND_API_KEY=
NOTIFICATION_EMAIL=reed@evrydayarchive.co
